# How the CurseForge packager should build this sound pack.
#
# The audio is committed here now, so the packager has everything it needs: a
# tagged commit builds a complete, playable pack.
#
# It used to carry "ignore: sounds", from when the clips were kept out of git
# and the line was merely true. Once the audio landed it became a trap instead:
# the packager would have stripped all 104,274 clips and shipped a pack that
# loads, declares what it covers, and is silent -- indistinguishable from a
# working one until somebody opens a quest. Auto-packaging is deliberately off
# for this project, so it never fired; the line is gone so that turning
# packaging on some day cannot quietly do it.
package-as: WordHunterWoW-Voice-DE-Words

enable-nolib-creation: no
